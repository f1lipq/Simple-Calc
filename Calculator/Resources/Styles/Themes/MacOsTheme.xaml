<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Calculator.Resources.Styles.Themes.MacOsTheme">

    <Color x:Key="PageBackgroundColor">#1C1C1E</Color>

    <Color x:Key="TextColor">#FFFFFF</Color>

    <Style x:Key="NumberButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#333333" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="FunctionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#FF9F0A" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="PageBackground" TargetType="Label">
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackgroundColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="32" />
    </Style>

</ResourceDictionary>