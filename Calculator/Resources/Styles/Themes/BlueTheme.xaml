<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Calculator.Resources.Styles.Themes.BlueTheme">

    <Color x:Key="PageBackgroundColor">#EAF4FC</Color>

    <Color x:Key="TextColor">#1F3347</Color>

    <Style x:Key="NumberButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#BDD7EE" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="FunctionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#9DC3E6" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="PageBackground" TargetType="Label">
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackgroundColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="32" />
    </Style>

</ResourceDictionary>