<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Calculator.Resources.Styles.Themes.DarkTheme">

    <Color x:Key="PageBackgroundColor">#1E1E1E</Color>

    <Color x:Key="TextColor">#FFFFFF</Color>

    <Style x:Key="NumberButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#3A3A3A" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="PixelFont"/>
    </Style>

    <Style x:Key="FunctionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#555555" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="PageBackground" TargetType="Label">
        <Setter Property="BackgroundColor" Value="#1E1E1E" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="32" />
    </Style>



</ResourceDictionary>