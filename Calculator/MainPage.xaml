<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.MainPage"
             Title="">

    <Grid RowDefinitions="0.8*,0.8*,*,*,*,*,*"
      ColumnDefinitions="*,*,*,*"
          RowSpacing="1"
          ColumnSpacing="1">
        <Label
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            x:Name="OutputEntry"
            VerticalTextAlignment="Center"
            FontSize="35"
            Margin="20, 0, 20, 0"
            HorizontalTextAlignment="End"
            FontFamily="PixelFont"
            
            />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            x:Name="OutputResult"
            VerticalTextAlignment="Center"
            FontSize="35"
            Margin="20, 0, 20, 0"
            HorizontalTextAlignment="End"
            TextColor="GhostWhite"
            />

        <Button Text="AC"
    Grid.Row="2"
    Grid.Column="0"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnClearClicked"/>

        <Button Text="()"
    Grid.Row="2"
    Grid.Column="1"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnParenthesesClicked"/>

        <Button Text="%"
    Grid.Row="2"
    Grid.Column="2"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnPercentClicked"/>

        <Button Text="/"
    Grid.Row="2"
    Grid.Column="3"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnOperatorClicked"/>

        <Button Text="7"
    Grid.Row="3"
    Grid.Column="0"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="8"
    Grid.Row="3"
    Grid.Column="1"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="9"
    Grid.Row="3"
    Grid.Column="2"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="X"
    Grid.Row="3"
    Grid.Column="3"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnOperatorClicked"/>

        <Button Text="4"
    Grid.Row="4"
    Grid.Column="0"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="5"
    Grid.Row="4"
    Grid.Column="1"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="6"
    Grid.Row="4"
    Grid.Column="2"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="-"
    Grid.Row="4"
    Grid.Column="3"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnOperatorClicked"/>

        <Button Text="1"
    Grid.Row="5"
    Grid.Column="0"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="2"
    Grid.Row="5"
    Grid.Column="1"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="3"
    Grid.Row="5"
    Grid.Column="2"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text="+"
    Grid.Row="5"
    Grid.Column="3"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnOperatorClicked"/>

        <Button Text="0"
    Grid.Row="6"
    Grid.Column="0"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDigitClicked"/>

        <Button Text=","
    Grid.Row="6"
    Grid.Column="1"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDecimalClicked"/>

        <Button Text="DEL"
    Grid.Row="6"
    Grid.Column="2"
    CornerRadius="0"
    Style="{StaticResource Button1}"
    Clicked="OnDeleteClicked"/>

        <Button Text="="
    Grid.Row="6"
    Grid.Column="3"
    CornerRadius="0"
    Style="{StaticResource Button2}"
    Clicked="OnEqualsClicked"/>



    </Grid>

</ContentPage>
